# --- BAZA BILAN ISHLASH ---
def load_db():
    if not os.path.exists(DB_FILE):
        return {}
    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}

def save_db(data):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4, ensure_ascii=False)

def register_user(user_id, referrer_id=None):
    db = load_db()
    user_str = str(user_id)
    is_new = False
    
    if user_str not in db:
        db[user_str] = {
            "balance": 0,
            "referrer": referrer_id,
            "referrals_count": 0
        }
        is_new = True
        
        # Referal bonusi (100 so'm)
        if referrer_id and str(referrer_id) != user_str:
            ref_str = str(referrer_id)
            if ref_str not in db:
                db[ref_str] = {"balance": 0, "referrer": None, "referrals_count": 0}
            
            db[ref_str]["balance"] = db[ref_str].get("balance", 0) + 100
            db[ref_str]["referrals_count"] = db[ref_str].get("referrals_count", 0) + 1
            
    save_db(db)
    return is_new

def get_user_data(user_id):
    db = load_db()
    user_str = str(user_id)
    if user_str not in db:
        return {"balance": 0, "referrer": None, "referrals_count": 0}
    return db[user_str]

def add_user_balance(user_id, amount):
    db = load_db()
    user_str = str(user_id)
    if user_str not in db:
        db[user_str] = {"balance": 0, "referrer": None, "referrals_count": 0}
    
    db[user_str]["balance"] += amount
    save_db(db)
    return db[user_str]["balance"]

