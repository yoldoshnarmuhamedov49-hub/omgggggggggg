    user_balance = user_data.get("balance", 0)

    if user_balance < price_num:
        msg_text = (
            f"❌ <b>Balansingiz yetarli emas.</b>\n\n"
            f"🛒 <b>Mahsulot:</b> {item_name}\n"
            f"💰 <b>Narxi:</b> {price_num:,} so'm\n"
            f"💳 <b>Sizning balansingiz:</b> {user_balance:,} so'm\n\n"
            f"📌 Balansni to'ldirish uchun ushbu VISA kartaga pul o'tkazing va chek hamda ID ingizni adminga yuboring:\n"
            f"💳 <b>Karta:</b> <code>{CARD_NUMBER}</code>\n"
            f"🆔 <b>Sizning ID:</b> <code>{user.id}</code>\n"
            f"👤 <b>Bosh Admin:</b> {ADMIN_USERNAME}"
        ).replace(",", " ")
        await callback.message.edit_text(msg_text)
        await callback.answer()
        return

    new_balance = add_user_balance(user.id, -price_num)
    
    msg_text = (
        f"✅ <b>Sizning buyurtmangiz qabul qilindi!</b>\n\n"
        f"📦 <b>Sotib olindi:</b> {item_name}\n"
        f"💵 <b>Yechildi:</b> {price_num:,} so'm\n"
        f"💳 <b>Qolgan balans:</b> {new_balance:,} so'm\n\n"
        f"📩 Buyurtmangizni olish uchun adminga yozing: {ADMIN_USERNAME}"
    ).replace(",", " ")
    await callback.message.edit_text(msg_text)
    await callback.answer()

    try:
        username_str = f"@{user.username}" if user.username else "yo'q"
        admin_notif = (
            f"🔔 <b>YANGI BUYURTMA!</b>\n\n"
            f"👤 <b>Mijoz:</b> {user.full_name} ({username_str})\n"
            f"🆔 <b>ID:</b> <code>{user.id}</code>\n"
            f"🛒 <b>Mahsulot:</b> {item_name} ({price_num:,} so'm)\n"
            f"💰 <b>Mijozning qolgan balansi:</b> {new_balance:,} so'm"
        ).replace(",", " ")
        await bot.send_message(chat_id=ADMIN_ID, text=admin_notif)
    except Exception as e:
        logging.error(f"Adminga bildirishnoma yuborishda xatolik: {e}")

